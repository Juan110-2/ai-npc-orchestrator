# ── Base de datos ────────────────────────────────────────────────────────────
# PostgreSQL local o Supabase connection string
DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# ── Proveedor de IA activo ───────────────────────────────────────────────────
# Opciones: openai | gemini | deepseek | mock
AI_PROVIDER=mock

# ── API Keys (solo la del proveedor activo es obligatoria) ───────────────────
OPENAI_API_KEY=sk-...
GEMINI_API_KEY=AIza...
DEEPSEEK_API_KEY=sk-...

# ── Supabase Auth (opcional) ─────────────────────────────────────────────────
# Obtener en: Supabase Dashboard → Project Settings → API → JWT Secret
# Si no se define, el middleware JWT se desactiva (útil para desarrollo local)
SUPABASE_JWT_SECRET=

# ── CORS ─────────────────────────────────────────────────────────────────────
# Orígenes permitidos separados por coma
CORS_ALLOW_ORIGINS=http://localhost:3000,http://localhost:5173
