# ── Base de datos ────────────────────────────────────────────────────────────
# PostgreSQL local o Supabase connection string (esquema postgresql+psycopg2://, necesario con SQLAlchemy 2.1)
DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/dbname
# Opcional: conexiones del pool (por defecto 5 + 10)
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=10

# ── Proveedor de IA activo ───────────────────────────────────────────────────
# Opciones: openai | gemini | deepseek | mock
AI_PROVIDER=mock

# ── API Keys (solo la del proveedor activo es obligatoria) ───────────────────
OPENAI_API_KEY=sk-...
GEMINI_API_KEY=AIza...
DEEPSEEK_API_KEY=sk-...

# ── Supabase Auth ─────────────────────────────────────────────────────────────
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJ...

# Obtener en: Supabase Dashboard → Project Settings → API → JWT Secret
# Obligatorio salvo que ALLOW_UNSECURE_MOCK_AUTH=true
SUPABASE_JWT_SECRET=

# Permite arrancar la app sin SUPABASE_JWT_SECRET (JWT sin validar). Solo desarrollo local.
ALLOW_UNSECURE_MOCK_AUTH=false

# ── CORS ─────────────────────────────────────────────────────────────────────
# Orígenes permitidos separados por coma
CORS_ALLOW_ORIGINS=http://localhost:3000,http://localhost:5173
